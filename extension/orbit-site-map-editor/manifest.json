{
  "manifest_version": 3,
  "name": "Orbit Site Map Editor",
  "description": "Adds exact-ID editing, graph validation, and mission-independent Site View coverage planning to the Orbit Site Map editor.",
  "version": "0.14.4",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/control_room/maps/*/edit*"
      ],
      "css": [
        "panel.css"
      ],
      "js": [
        "extension-context.js",
        "panel-layout.js",
        "model.js",
        "query.js",
        "selection.js",
        "validation.js",
        "edge-settings-contract.js",
        "workflow.js",
        "walk-planner.js",
        "area-settings.js",
        "overlay-settings.js",
        "overlay-renderer.js",
        "content.js",
        "workspace-controller.js",
        "workspace-select.js",
        "workspace-action-names.js",
        "workspace-edit.js",
        "workspace-validate.js",
        "advanced.js",
        "areas-ui.js",
        "walk-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
